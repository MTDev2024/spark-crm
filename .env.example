# Copier ce fichier en .env.local et renseigner les valeurs de VOTRE projet Supabase
# (Connect > Framework dans le tableau de bord Supabase).
# Ces deux valeurs sont publiques par conception : la sécurité repose sur la RLS.
# Ne jamais mettre ici la clé « secret » / « service_role ».
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
